import java.util.Scanner;

public class ResistorColorCode {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] colors = {
            "black", "brown", "red", "orange", "yellow",
            "green", "blue", "violet", "grey", "white"
        };

        System.out.print("Enter first color: ");
        String c1 = sc.next().toLowerCase();

        System.out.print("Enter second color: ");
        String c2 = sc.next().toLowerCase();

        System.out.print("Enter third color: ");
        String c3 = sc.next().toLowerCase();

        int d1 = findColor(colors, c1);
        int d2 = findColor(colors, c2);
        int multiplier = findColor(colors, c3);

        if (d1 == -1 || d2 == -1 || multiplier == -1) {
            System.out.println("Invalid color!");
        } else {
            double resistance = (d1 * 10 + d2) * Math.pow(10, multiplier);
            System.out.println("Resistance = " + resistance + " Ohms");
        }

        sc.close();
    }

    static int findColor(String[] colors, String color) {
        for (int i = 0; i < colors.length; i++) {
            if (colors[i].equals(color))
                return i;
        }
        return -1;
    }
}
