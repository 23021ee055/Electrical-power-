import java.util.Scanner;

public class ScientificCalculator {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("1. Square Root");
        System.out.println("2. Power");
        System.out.println("3. Sine");
        System.out.println("4. Cosine");
        System.out.println("5. Logarithm");

        System.out.print("Enter your choice: ");
        int choice = sc.nextInt();

        System.out.print("Enter number: ");
        double number = sc.nextDouble();

        switch (choice) {
            case 1:
                System.out.println("Square Root = " + Math.sqrt(number));
                break;

            case 2:
                System.out.print("Enter power: ");
                double power = sc.nextDouble();
                System.out.println("Result = " + Math.pow(number, power));
                break;

            case 3:
                System.out.println("Sin = " + Math.sin(Math.toRadians(number)));
                break;

            case 4:
                System.out.println("Cos = " + Math.cos(Math.toRadians(number)));
                break;

            case 5:
                System.out.println("Log = " + Math.log(number));
                break;

            default:
                System.out.println("Invalid choice!");
        }

        sc.close();
    }
}
