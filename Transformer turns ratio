import java.util.Scanner;

public class TransformerTurnsRatio {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Primary Voltage V1: ");
        double v1 = sc.nextDouble();

        System.out.print("Enter Primary Turns N1: ");
        double n1 = sc.nextDouble();

        System.out.print("Enter Secondary Turns N2: ");
        double n2 = sc.nextDouble();

        double v2 = (v1 * n2) / n1;

        System.out.println("Secondary Voltage V2 = " + v2 + " V");

        sc.close();
    }
}
